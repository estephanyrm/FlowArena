<h2>Editar perfil de administrador</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "admins/shared/error_messages", resource: resource %>

  <div class="field">
    <p><%= f.label :email, "Correo electrónico" %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Esperando confirmación para: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="field">
    <p><%= f.label :password, "Nueva contraseña" %> <i>(déjala en blanco si no deseas cambiarla)</i></p>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>
    <% if @minimum_password_length %>
      <p><em>Mínimo <%= @minimum_password_length %> caracteres</em></p>
    <% end %>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, "Confirmar nueva contraseña" %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :current_password, "Contraseña actual" %> <i>(necesaria para confirmar los cambios)</i></p>
    <p><%= f.password_field :current_password, autocomplete: "current-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit "Guardar cambios" %>
  </div>
<% end %>

<h3>Cancelar mi cuenta</h3>

<div>
  ¿Deseas cancelar tu cuenta?
  <%= button_to "Cancelar mi cuenta",
        registration_path(resource_name),
        data: { turbo_confirm: "¿Estás seguro? Esta acción no se puede deshacer." },
        method: :delete %>
</div>

<%= link_to "Volver", :back %>