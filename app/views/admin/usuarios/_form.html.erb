<%= form_with model: [:admin, @usuario], url: @usuario.new_record? ? admin_usuarios_path : admin_usuario_path(@usuario) do |f| %>
  <div>
    <%= f.label :name, "Nombre" %>
    <%= f.text_field :name %>
  </div>
  <div>
    <%= f.label :email, "Email" %>
    <%= f.email_field :email %>
  </div>
  <div>
    <%= f.label :password, "Contraseña" %>
    <%= f.password_field :password %>
  </div>
  <%= f.submit @usuario.new_record? ? "Crear usuario" : "Actualizar usuario" %>
<% end %>