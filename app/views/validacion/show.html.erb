<%# Vista de validación de boleto — usada por personal del recinto %>
<% content_for :title, "Validación de Boleto – Flow Arena" %>

<div class="min-h-screen bg-gray-100 flex items-center justify-center px-4 py-12">
  <div class="bg-white rounded-2xl shadow-lg w-full max-w-md overflow-hidden">

    <%# Cabecera según estado %>
    <% if @estado == :valido %>
      <div class="bg-green-500 px-6 py-8 text-center">
        <div class="text-6xl mb-3">✅</div>
        <h1 class="text-2xl font-black text-white">BOLETO VÁLIDO</h1>
        <p class="text-green-100 mt-1 text-sm">Listo para ingresar</p>
      </div>
    <% elsif @estado == :ya_usado %>
      <div class="bg-yellow-500 px-6 py-8 text-center">
        <div class="text-6xl mb-3">⚠️</div>
        <h1 class="text-2xl font-black text-white">YA UTILIZADO</h1>
        <p class="text-yellow-100 mt-1 text-sm">Este boleto ya fue escaneado</p>
      </div>
    <% else %>
      <div class="bg-red-500 px-6 py-8 text-center">
        <div class="text-6xl mb-3">❌</div>
        <h1 class="text-2xl font-black text-white">BOLETO INVÁLIDO</h1>
        <p class="text-red-100 mt-1 text-sm"><%= @mensaje %></p>
      </div>
    <% end %>

    <%# Detalles del boleto si existe %>
    <% if @boleto %>
      <div class="px-6 py-5 space-y-3">
        <div class="flex justify-between text-sm border-b pb-3">
          <span class="text-gray-500 font-medium">Evento</span>
          <span class="font-bold text-gray-900"><%= @boleto.nombre_evento_safe %></span>
        </div>
        <div class="flex justify-between text-sm border-b pb-3">
          <span class="text-gray-500 font-medium">Fecha</span>
          <span class="font-bold text-gray-900">
            <%= @boleto.fecha_evento_safe&.strftime("%d/%m/%Y") || "—" %>
          </span>
        </div>
        <div class="flex justify-between text-sm border-b pb-3">
          <span class="text-gray-500 font-medium">Hora</span>
          <span class="font-bold text-gray-900">
            <%= @boleto.hora_evento_safe&.strftime("%I:%M %p") || "—" %>
          </span>
        </div>
        <div class="flex justify-between text-sm border-b pb-3">
          <span class="text-gray-500 font-medium">Zona</span>
          <span class="font-bold text-gray-900"><%= @boleto.nombre_zona_safe %></span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-gray-500 font-medium">N° Orden</span>
          <span class="font-mono text-xs text-gray-700"><%= @boleto.compra&.numero_orden || "—" %></span>
        </div>
      </div>

      <%# Botón de confirmar ingreso solo si es válido %>
      <% if @estado == :valido %>
        <div class="px-6 pb-6">
          <%= button_to "Confirmar ingreso",
                confirmar_validacion_path(params[:token]),
                method: :post,
                class: "w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded-xl text-sm transition-colors" %>
        </div>
      <% end %>
    <% end %>

    <%# Flash messages %>
    <% if notice %>
      <div class="mx-6 mb-6 p-3 bg-green-50 border border-green-200 rounded-lg text-sm text-green-800 text-center font-medium">
        <%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div class="mx-6 mb-6 p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-800 text-center font-medium">
        <%= alert %>
      </div>
    <% end %>

    <div class="px-6 pb-6 text-center">
      <p class="text-xs text-gray-400">Flow Arena · Sistema de Boletería Digital</p>
    </div>
  </div>
</div>